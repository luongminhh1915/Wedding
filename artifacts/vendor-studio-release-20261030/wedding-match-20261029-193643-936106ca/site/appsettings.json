{
  "Database": {
    "Provider": "SqlServer",
    "SeedDemoData": false,
    "ApplyMigrations": false
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Issuer": "WeddingPlatform",
    "ExpiryMinutes": 1440,
    "Audience": "WeddingPlatformClient",
    "Secret": ""
  },
  "Uploads": {
    "ListingRoot": "../private/uploads/listings",
    "InvitationAudioRoot": "../private/uploads/invitation-audio",
    "InvitationRoot": "../private/uploads/invitations"
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}
