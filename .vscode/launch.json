{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Run WebApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/src/Wedding.WebApi/bin/Debug/net8.0/Wedding.WebApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Wedding.WebApi",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
