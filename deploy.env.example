# Copy to a PRIVATE deployment environment. Never commit filled credentials.
ASPNETCORE_ENVIRONMENT=Production
Database__Provider=SqlServer
Database__SeedDemoData=false
Database__ApplyMigrations=false
ConnectionStrings__DefaultConnection=Server=YOUR_SQL_HOST;Database=WeddingMatch;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=false;Max Pool Size=20
JwtSettings__Secret=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
Cors__Origins__0=https://YOUR_DOMAIN
Google__ClientId=
Facebook__AppId=
Facebook__AppSecret=
Facebook__GraphApiVersion=
# Set to the frontend origin after deploy, e.g. https://weddingmatch.website
Auth__PasswordResetBaseUrl=
Smtp__Host=
Smtp__Port=587
Smtp__From=
Smtp__Username=
Smtp__Password=
Payments__BankCode=
Payments__AccountNumber=
Payments__AccountName=
BankWebhook__Secret=
BankWebhook__AccountNumber=
# Docker: mount a persistent volume at /data and back it up separately from SQL Server.
Uploads__InvitationRoot=/data/invitation-uploads
Uploads__InvitationAudioRoot=/data/invitation-audio
Uploads__ListingRoot=/data/listing-uploads
# MonsterASP shared IIS: use ../private/uploads/invitations, ../private/uploads/invitation-audio and ../private/uploads/listings instead.
# Private settings default to ../private/wedding.production.json (outside the published application).
# WEDDING_PRIVATE_CONFIG=/run/secrets/wedding.production.json
# Study build: VITE_API_URL must be empty (same origin), VITE_STUDY_MODE=true. These are build-time values.
# Google key is public; SMTP/webhook secrets stay SERVER-SIDE, never in VITE_*.
